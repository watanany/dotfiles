deny sed * ~/.gnupg/* "GPG keys must not be read."
deny sed * *.env "Secrets must not be read."
deny sed * *.env.* "Secrets must not be read."
deny wc ~/.ssh/* "SSH keys must not be read."
deny wc ~/.aws/* "AWS credentials must not be read."
deny wc ~/.gnupg/* "GPG keys must not be read."
deny wc *.env "Secrets must not be read."
deny wc *.env.* "Secrets must not be read."
deny wc * ~/.ssh/* "SSH keys must not be read."
deny wc * ~/.aws/* "AWS credentials must not be read."
deny wc * ~/.gnupg/* "GPG keys must not be read."
deny wc * *.env "Secrets must not be read."
deny wc * *.env.* "Secrets must not be read."

# --- Redirect protection ---
deny-redirect **/.env* "Never write secrets. Ask the user to do it manually."
deny-redirect ~/.ssh/** "SSH directory is protected."
deny-redirect ~/.aws/** "AWS credentials directory is protected."
deny-redirect ~/.snowflake/** "Snowflake config directory is protected"
deny-redirect ~/.git/** "Global git directory is protected"


