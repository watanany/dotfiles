deny rg ~/.ssh/* "SSH keys must not be read."
deny rg ~/.aws/* "AWS credentials must not be read."
deny rg ~/.gnupg/* "GPG keys must not be read."
deny rg *.env "Secrets must not be read."
deny rg *.env.* "Secrets must not be read."
deny rg * ~/.ssh/* "SSH keys must not be read."
deny rg * ~/.aws/* "AWS credentials must not be read."
